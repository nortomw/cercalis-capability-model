<svg width="920" height="890" viewBox="0 0 920 890" xmlns="http://www.w3.org/2000/svg" role="img" font-family="Arial, Helvetica, sans-serif">
<title>Flujo del Capability Model</title>
<desc>Capability se descompone en Contexto, Estructura y Conocimiento; converge en Finding, Recomendación e Implementación; se despliega en Servicios, Integraciones y Automatización; y cierra el ciclo con Uso real, Calibración y Evolución, que retroalimenta a Capability.</desc>
<defs>
<marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
<path d="M0,0 L10,5 L0,10 Z" fill="#3d3d3a"/>
</marker>
<marker id="arrow-loop" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
<path d="M0,0 L10,5 L0,10 Z" fill="#5F5E5A"/>
</marker>
</defs>

<!-- Row 1: CAPABILITY -->
<rect x="330" y="40" width="240" height="54" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1.5"/>
<text x="450" y="73" text-anchor="middle" font-size="15" font-weight="700" fill="#2C2C2A">CAPABILITY</text>

<line x1="450" y1="94" x2="450" y2="124" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>

<!-- Row 2: CONTEXTO / ESTRUCTURA / CONOCIMIENTO -->
<rect x="60" y="130" width="240" height="70" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="1.5"/>
<text x="180" y="158" text-anchor="middle" font-size="14" font-weight="700" fill="#04342C">CONTEXTO</text>
<text x="180" y="178" text-anchor="middle" font-size="12" fill="#0F6E56">Tipo · Sector · Tecnología</text>

<rect x="330" y="130" width="240" height="70" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="1.5"/>
<text x="450" y="158" text-anchor="middle" font-size="14" font-weight="700" fill="#04342C">ESTRUCTURA</text>
<text x="450" y="178" text-anchor="middle" font-size="12" fill="#0F6E56">Arquitectura · Componentes</text>

<rect x="600" y="130" width="240" height="70" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="1.5"/>
<text x="720" y="158" text-anchor="middle" font-size="14" font-weight="700" fill="#04342C">CONOCIMIENTO</text>
<text x="720" y="178" text-anchor="middle" font-size="12" fill="#0F6E56">Reglas · Evidencia</text>

<!-- converge to Finding -->
<path d="M180 200 C180 222, 380 222, 444 234" fill="none" stroke="#3d3d3a" stroke-width="2" marker-end="url(#arrow)"/>
<path d="M450 200 L450 232" fill="none" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>
<path d="M720 200 C720 222, 520 222, 456 234" fill="none" stroke="#3d3d3a" stroke-width="2" marker-end="url(#arrow)"/>

<!-- Row 3: FINDING -->
<rect x="330" y="240" width="240" height="54" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1.5"/>
<text x="450" y="273" text-anchor="middle" font-size="15" font-weight="700" fill="#2C2C2A">FINDING</text>

<line x1="450" y1="294" x2="450" y2="324" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>

<!-- Row 4: RECOMENDACIÓN -->
<rect x="330" y="330" width="240" height="54" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1.5"/>
<text x="450" y="363" text-anchor="middle" font-size="15" font-weight="700" fill="#2C2C2A">RECOMENDACIÓN</text>

<line x1="450" y1="384" x2="450" y2="414" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>

<!-- Row 5: IMPLEMENTACIÓN -->
<rect x="330" y="420" width="240" height="54" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1.5"/>
<text x="450" y="453" text-anchor="middle" font-size="15" font-weight="700" fill="#2C2C2A">IMPLEMENTACIÓN</text>

<!-- branch down to Servicios / Integraciones / Automatización -->
<path d="M450 474 C450 494, 190 494, 180 508" fill="none" stroke="#3d3d3a" stroke-width="2" marker-end="url(#arrow)"/>
<line x1="450" y1="474" x2="450" y2="504" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>
<path d="M450 474 C450 494, 710 494, 720 508" fill="none" stroke="#3d3d3a" stroke-width="2" marker-end="url(#arrow)"/>

<!-- Row 6: SERVICIOS / INTEGRACIONES / AUTOMATIZACIÓN -->
<rect x="60" y="510" width="240" height="70" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="1.5"/>
<text x="180" y="538" text-anchor="middle" font-size="14" font-weight="700" fill="#4A1B0C">SERVICIOS</text>
<text x="180" y="558" text-anchor="middle" font-size="12" fill="#993C1D">Servicios al cliente</text>

<rect x="330" y="510" width="240" height="70" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="1.5"/>
<text x="450" y="538" text-anchor="middle" font-size="14" font-weight="700" fill="#4A1B0C">INTEGRACIONES</text>
<text x="450" y="558" text-anchor="middle" font-size="12" fill="#993C1D">Conexiones externas</text>

<rect x="600" y="510" width="240" height="70" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="1.5"/>
<text x="720" y="538" text-anchor="middle" font-size="14" font-weight="700" fill="#4A1B0C">AUTOMATIZACIÓN</text>
<text x="720" y="558" text-anchor="middle" font-size="12" fill="#993C1D">Procesos automáticos</text>

<!-- converge to Uso real -->
<path d="M180 580 C180 602, 380 602, 444 614" fill="none" stroke="#3d3d3a" stroke-width="2" marker-end="url(#arrow)"/>
<path d="M450 580 L450 612" fill="none" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>
<path d="M720 580 C720 602, 520 602, 456 614" fill="none" stroke="#3d3d3a" stroke-width="2" marker-end="url(#arrow)"/>

<!-- Row 7: USO REAL -->
<rect x="330" y="620" width="240" height="54" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="1.5"/>
<text x="450" y="653" text-anchor="middle" font-size="15" font-weight="700" fill="#042C53">USO REAL</text>

<line x1="450" y1="674" x2="450" y2="704" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>

<!-- Row 8: CALIBRACIÓN -->
<rect x="330" y="710" width="240" height="54" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="1.5"/>
<text x="450" y="743" text-anchor="middle" font-size="15" font-weight="700" fill="#042C53">CALIBRACIÓN</text>

<line x1="450" y1="764" x2="450" y2="794" stroke="#3d3d3a" stroke-width="2.5" marker-end="url(#arrow)"/>

<!-- Row 9: EVOLUCIÓN -->
<rect x="330" y="800" width="240" height="54" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="1.5"/>
<text x="450" y="833" text-anchor="middle" font-size="15" font-weight="700" fill="#042C53">EVOLUCIÓN</text>

<!-- feedback loop back to Capability -->
<path d="M570 823 C 860 823, 890 700, 890 465 C 890 230, 860 67, 574 67" fill="none" stroke="#5F5E5A" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#arrow-loop)"/>
<text x="900" y="465" text-anchor="middle" font-size="12" font-weight="700" fill="#5F5E5A" transform="rotate(-90 900 465)">RETROALIMENTA LA CAPABILITY</text>

</svg>
